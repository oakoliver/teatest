{
  "name": "@oakoliver/teatest",
  "version": "1.0.0",
  "description": "Test helpers for Bubble Tea programs in TypeScript: run a model at a fixed terminal size, send keys, wait for output and compare it with golden files. A port of Charm's teatest",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:esm": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --target=esnext --external:@oakoliver/bubbletea",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=node --outfile=dist/index.cjs --target=esnext --external:@oakoliver/bubbletea",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:examples": "bun test examples",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tui",
    "terminal",
    "testing",
    "golden",
    "snapshot",
    "test",
    "bubbletea",
    "teatest",
    "charmbracelet",
    "typescript"
  ],
  "author": "Antonio Oliveira <antonio@oakoliver.com> (https://oakoliver.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oakoliver/teatest"
  },
  "homepage": "https://github.com/oakoliver/teatest#readme",
  "bugs": {
    "url": "https://github.com/oakoliver/teatest/issues"
  },
  "peerDependencies": {
    "@oakoliver/bubbletea": "^1.2.1"
  },
  "devDependencies": {
    "@oakoliver/bubbles": "^1.2.2",
    "@oakoliver/bubbletea": "^1.2.1",
    "@oakoliver/lipgloss": "^1.1.3",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  }
}
